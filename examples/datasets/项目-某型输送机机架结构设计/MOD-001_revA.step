ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('带式输送机机架三维模型'),'2;1');
FILE_NAME('MOD-001_revA.step','2026-09-18T10:24:00',('张伟'),('某机械设计院'),'iterd','iterd 0.1.0','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 -1 1 5 4 }'));
ENDSEC;
DATA;
/* 坐标系 */
#1 = CARTESIAN_POINT('原点',(0.0,0.0,0.0));
#2 = DIRECTION('X轴',(1.0,0.0,0.0));
#3 = DIRECTION('Y轴',(0.0,1.0,0.0));
#4 = DIRECTION('Z轴',(0.0,0.0,1.0));
#5 = AXIS2_PLACEMENT_3D('世界坐标系',#1,#4,#2);
/* 纵梁 FRM-01：方管 120x120x6 L=6000，机长方向 4 段 */
#10 = CARTESIAN_POINT('纵梁起点',(0.0,0.0,0.0));
#11 = DIRECTION('纵梁方向',(1.0,0.0,0.0));
#12 = ADVANCED_BREP_SHAPE_REPRESENTATION('纵梁段1',(#10,#11),#5);
#13 = SHAPE_DEFINITION_REPRESENTATION('FRM-01-1','纵梁 方管120x120x6 L=6000',#12);
#14 = PRODUCT('FRM-01-1','纵梁段1','Q235B',(#13));
/* 横梁 FRM-02：方管 80x40x5 L=2000，间距 2000 共 12 根 */
#20 = CARTESIAN_POINT('横梁起点',(2000.0,0.0,0.0));
#21 = DIRECTION('横梁方向',(0.0,1.0,0.0));
#22 = ADVANCED_BREP_SHAPE_REPRESENTATION('横梁1',(#20,#21),#5);
#23 = SHAPE_DEFINITION_REPRESENTATION('FRM-02-1','横梁 方管80x40x5 L=2000',#22);
#24 = PRODUCT('FRM-02-1','横梁1','Q235B',(#23));
/* 支腿 FRM-03：方管 100x100x5 L=1100 */
#30 = CARTESIAN_POINT('支腿起点',(2000.0,0.0,-1100.0));
#31 = DIRECTION('支腿方向',(0.0,0.0,1.0));
#32 = ADVANCED_BREP_SHAPE_REPRESENTATION('支腿1',(#30,#31),#5);
#33 = SHAPE_DEFINITION_REPRESENTATION('FRM-03-1','支腿 方管100x100x5 L=1100',#32);
#34 = PRODUCT('FRM-03-1','支腿1','Q235B',(#33));
/* 装配关系 */
#40 = PRODUCT_DEFINITION('机架总成','带式输送机机架总成',#14);
#41 = PRODUCT_DEFINITION_RELATIONSHIP('装配','机架总成装配',#40,#24);
#42 = PRODUCT_DEFINITION_RELATIONSHIP('装配','机架总成装配',#40,#34);
ENDSEC;

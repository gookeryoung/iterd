ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('带式输送机传动轴三维模型'),'2;1');
FILE_NAME('SHF-301_revA.step','2026-09-18T10:24:00',('张伟'),('某机械设计院'),'iterd','iterd 0.1.0','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 -1 1 5 4 }'));
ENDSEC;
DATA;
/* 坐标系 */
#1 = CARTESIAN_POINT('原点',(0.0,0.0,0.0));
#2 = DIRECTION('X轴',(1.0,0.0,0.0));
#3 = DIRECTION('Y轴',(0.0,1.0,0.0));
#4 = DIRECTION('Z轴',(0.0,0.0,1.0));
#5 = AXIS2_PLACEMENT_3D('世界坐标系',#1,#4,#2);
/* 传动轴 AXLE-01：Φ45 L=1250，45钢调质，两轴段 */
#10 = CARTESIAN_POINT('轴段1起点',(0.0,0.0,0.0));
#11 = DIRECTION('轴向',(1.0,0.0,0.0));
#12 = ADVANCED_BREP_SHAPE_REPRESENTATION('传动轴段1',(#10,#11),#5);
#13 = SHAPE_DEFINITION_REPRESENTATION('AXLE-01-1','传动轴 Φ45 L=1250',#12);
#14 = PRODUCT('AXLE-01-1','传动轴段1','45钢',(#13));
#20 = CARTESIAN_POINT('轴段2起点',(1250.0,0.0,0.0));
#21 = ADVANCED_BREP_SHAPE_REPRESENTATION('传动轴段2',(#20,#11),#5);
#22 = SHAPE_DEFINITION_REPRESENTATION('AXLE-01-2','传动轴 Φ45 L=1250',#21);
#23 = PRODUCT('AXLE-01-2','传动轴段2','45钢',(#22));
/* 联轴器 AXLE-02：GL4 弹性柱销联轴器 */
#30 = CARTESIAN_POINT('联轴器中心',(1250.0,0.0,0.0));
#31 = ADVANCED_BREP_SHAPE_REPRESENTATION('联轴器',(#30,#11),#5);
#32 = SHAPE_DEFINITION_REPRESENTATION('AXLE-02','联轴器 GL4',#31);
#33 = PRODUCT('AXLE-02','弹性柱销联轴器','45钢',(#32));
/* 键槽：A 型平键 14x9x70 */
#40 = CARTESIAN_POINT('键槽基准',(600.0,22.5,0.0));
#41 = ADVANCED_BREP_SHAPE_REPRESENTATION('键槽',(#40,#11),#5);
#42 = SHAPE_DEFINITION_REPRESENTATION('KEY-01','平键槽 14x9x70',#41);
#43 = PRODUCT('KEY-01','A型平键槽','45钢',(#42));
ENDSEC;
END-ISO-10303-21;

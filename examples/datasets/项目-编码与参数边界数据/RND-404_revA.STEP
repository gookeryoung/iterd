ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('传动轴三维模型改型（大写扩展名边界数据）'),'2;1');
FILE_NAME('RND-404_revA.STEP','2026-09-26T14:20:00',('张伟'),('某机械设计院'),'iterd','iterd 0.1.0','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 -1 1 5 4 }'));
ENDSEC;
DATA;
/* 坐标系 */
#1 = CARTESIAN_POINT('原点',(0.0,0.0,0.0));
#2 = DIRECTION('X轴',(1.0,0.0,0.0));
#3 = DIRECTION('Y轴',(0.0,1.0,0.0));
#4 = DIRECTION('Z轴',(0.0,0.0,1.0));
#5 = AXIS2_PLACEMENT_3D('世界坐标系',#1,#4,#2);
/* 传动轴 SHAFT-01 改型：Φ45 L=1250，45钢调质（扩展名大写 .STEP，白名单判定大小写不敏感） */
#10 = CARTESIAN_POINT('轴段起点',(0.0,0.0,0.0));
#11 = DIRECTION('轴向',(1.0,0.0,0.0));
#12 = ADVANCED_BREP_SHAPE_REPRESENTATION('传动轴改型',(#10,#11),#5);
#13 = SHAPE_DEFINITION_REPRESENTATION('SHAFT-01-R2','传动轴改型 Φ45 L=1250',#12);
#14 = PRODUCT('SHAFT-01-R2','传动轴改型','45钢',(#13));
ENDSEC;
END-ISO-10303-21;
